{
	"name": "obsidian-defuddle-plugin",
	"version": "1.0.0",
	"description": "Parse a URL with Defuddle and save the extracted article as a note.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
